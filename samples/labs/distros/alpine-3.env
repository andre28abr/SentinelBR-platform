VM_NAME=lab-alpine-3
# OrbStack so disponibiliza versoes recentes (3.23 atualmente — 3.20 nao
# foi encontrada). Como Alpine quebra branch a cada 6 meses, usamos "alpine"
# sem version pra sempre pegar a latest stable disponivel.
DISTRO=alpine
ARCH=arm64
PKG_MGR=apk
DISPLAY_NAME="Lab Alpine 3"
HOSTNAME=lab-alpine-3.orb.local
AGGRESSIVE=false
SCENARIO="container-edge"
SCENARIO_LABEL="Linux minimo (musl libc): testa cross-compile + footprint pequeno"
# Alpine usa musl + apk — agente Go precisa CGO_ENABLED=0 (ja eh o default
# do build estatico). Hardening tools tem cobertura PARCIAL: clamav existe,
# fail2ban+aide existem, rkhunter+chkrootkit+lynis nao tem package no Alpine
# main repo (silencia gracefully — cards mostram "nao detectado").
INSTALL_CLAMAV=true
INSTALL_HARDENING_TOOLS=true
