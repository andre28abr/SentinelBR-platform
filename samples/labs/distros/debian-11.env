VM_NAME=lab-debian-11
DISTRO=debian:11
ARCH=arm64
PKG_MGR=apt
DISPLAY_NAME="Lab Debian 11"
HOSTNAME=lab-debian-11.orb.local
AGGRESSIVE=false
SCENARIO="ssh-bruteforce"
SCENARIO_LABEL="Brute-force SSH + auto-block"
# Todas as VMs instalam ClamAV + suite hardening (Tier 1+2). Distros sem
# AppArmor (Fedora/Rocky) ou sem SELinux (Debian/Ubuntu) silenciam grace.
INSTALL_CLAMAV=true
INSTALL_HARDENING_TOOLS=true
