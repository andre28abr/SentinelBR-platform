# Copie para deploy/.env e preencha. Apenas para docker-compose.yml (prod).
# Para dev, docker-compose.dev.yml usa defaults inseguros.
POSTGRES_USER=sentinelbr
POSTGRES_PASSWORD=
POSTGRES_DB=sentinelbr

REDIS_PASSWORD=

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

JWT_SECRET=

# ─── server (Pydantic Settings — prefix SENTINELBR_) ──────────────────────────
# Endpoints publicos — usados no install_command que mostra na UI:
SENTINELBR_PUBLIC_ENDPOINT=https://api.empresa.com.br
SENTINELBR_GRPC_PUBLIC_ENDPOINT=grpc.empresa.com.br:9443

# CORS: dominios autorizados a chamar a API (UI publicada). Lista por virgula.
SENTINELBR_CORS_ALLOWED_ORIGINS=https://app.empresa.com.br

# SAN do server cert mTLS — precisa cobrir o hostname pelo qual agents conectam.
# Tem que incluir "sentinelbr-server" (usado como ServerName/SNI pelo agent).
# IMPORTANTE: mudar aqui requer apagar server/data/server.crt e server.key e reiniciar.
SENTINELBR_SERVER_CERT_SAN=grpc.empresa.com.br,sentinelbr-server
SENTINELBR_SERVER_CERT_SAN_IPS=

# LGPD: retencao audit logs (Art. 16). Default 180 dias.
SENTINELBR_AUDIT_RETENTION_DAYS=180

# YARA scheduled scan: paths default + intervalo
SENTINELBR_YARA_SCHEDULED_PATHS=/var/www,/tmp,/home
SENTINELBR_YARA_SCHEDULED_INTERVAL_SECONDS=86400
